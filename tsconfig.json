{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/_layout.tsx",
    "app/index.tsx",
    "app/(tabs)/learning/_layout.tsx",
    "app/(auth)/_layout.tsx",
    "app/(auth)/login.tsx"
  ]
}
